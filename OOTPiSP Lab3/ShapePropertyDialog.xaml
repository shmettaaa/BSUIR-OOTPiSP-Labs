<Window x:Class="OOTPiSP_Lab3.ShapePropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Shape Properties" Height="520" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edit Shape Properties:" FontWeight="Bold" Margin="5"/>

        <ScrollViewer Grid.Row="1" Margin="5" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PropertiesPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="OK" Click="OnOkClick" Width="100" Margin="5" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancelClick" Width="100" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>