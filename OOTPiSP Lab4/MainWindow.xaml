<Window x:Class="FiguresApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Графический редактор"
        Height="680" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" Padding="10">
            <StackPanel>

                <TextBlock Text="Фигура" FontWeight="Bold" Margin="0,0,0,6"/>
                <ComboBox x:Name="cmbShapeTypes" Margin="0,0,0,16" SelectionChanged="cmbShapeTypes_SelectionChanged"/>

                <TextBlock Text="Цвет линии" FontWeight="Bold" Margin="0,0,0,6"/>
                <xctk:ColorPicker x:Name="colorPickerStroke" SelectedColor="Black" Margin="0,0,0,12" Height="26"/>

                <TextBlock Text="Цвет заливки" FontWeight="Bold" Margin="0,0,0,6"/>
                <xctk:ColorPicker x:Name="colorPickerFill" SelectedColor="LightGray" Margin="0,0,0,12" Height="26"/>

                <CheckBox x:Name="chkFilled" Content="Заливка" IsChecked="True" Margin="0,0,0,16"/>

                <TextBlock Text="Толщина" FontWeight="Bold" Margin="0,0,0,6"/>
                <Slider x:Name="sldThickness" Minimum="1" Maximum="15" Value="2" 
                        Margin="0,0,0,12" TickFrequency="1" IsSnapToTickEnabled="True"/>

                <StackPanel x:Name="polygonPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Стороны" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Slider x:Name="sldSides" Minimum="3" Maximum="12" Value="5" 
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <Button x:Name="btnClear" Content="Очистить" Margin="0,12,0,0" Padding="8" 
                        Click="btnClear_Click" Background="#E74C3C" Foreground="White"/>

            </StackPanel>
        </Border>

        <Canvas x:Name="drawingCanvas" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                Background="White" Margin="1"
                MouseLeftButtonDown="drawingCanvas_MouseLeftButtonDown"/>
    </Grid>
</Window>